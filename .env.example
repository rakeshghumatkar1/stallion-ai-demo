# ---------------------------------------------------------------------------
# Stallion AI Assistant — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Everything here is intentionally swappable; nothing below is hardcoded in app
# code. The one hard rule still applies: hard facts come from the DB, not env.
# ---------------------------------------------------------------------------

# Postgres connection string. Must be a database with the pgvector extension
# available (the first migration runs CREATE EXTENSION IF NOT EXISTS vector).
# Default host is Neon, but any Postgres works.
# Example (Neon): postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# --- OpenAI (the single provider: chat model AND embeddings, one key) ---
OPENAI_API_KEY=
# Chat model id (OpenAI Responses API). Default: gpt-5.6-terra (balanced tier).
MODEL_ID=gpt-5.6-terra

# --- Embeddings (behind a provider wrapper, see lib/kb/embed.ts) ---
# Currently supported: openai (uses OPENAI_API_KEY above)
EMBEDDINGS_PROVIDER=openai
# Embedding vector dimension. Must match the model AND the DB vector column.
# OpenAI text-embedding-3-small = 1536.
EMBEDDING_DIM=1536

# --- Event pin (THE isolation boundary) ---
# The ONE event this deployment serves. India and UAE are separate deployments
# of this same codebase, each pinned to its own event slug. A visitor can never
# switch events: there is no request-derived event id anywhere in the app.
ACTIVE_EVENT_ID=INDIA-2027

# --- Admin auth (Phase 1 simple auth; clean seam for Auth.js later) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie. Falls back to a value derived
# from ADMIN_PASSWORD if unset; set it explicitly in production.
ADMIN_SESSION_SECRET=

# --- Handoff / team notification ---
# Channel used to notify the team on escalation: email | slack | whatsapp
HANDOFF_CHANNEL=email
# Where handoff notifications are sent (email address for the email channel).
HANDOFF_EMAIL=team@example.com
# Email sending API key (Resend). Optional in dev: if absent, handoff emails are
# logged to the console instead of being sent.
RESEND_API_KEY=
# Optional sender for handoff emails.
# HANDOFF_FROM=Stallion Assistant <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Notes
# - Add a second language later by translating the string tables in
#   lib/ai/system-prompt.ts and lib/types.ts; nothing needs restructuring.
# ---------------------------------------------------------------------------
