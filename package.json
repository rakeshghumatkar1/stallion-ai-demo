{
  "name": "stallion-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Grounded, safe UAE event and nomination assistant for Digital Stallion.",
  "scripts": {
    "dev": "next dev",
    "build": "vitest run && tsx --tsconfig scripts/tsconfig.json scripts/load-content.ts --event UAE-GMM-2026-TEST --event-only && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig scripts/tsconfig.json scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "seed": "tsx --tsconfig scripts/tsconfig.json scripts/seed.ts",
    "content:load": "tsx --tsconfig scripts/tsconfig.json scripts/load-content.ts",
    "questions": "tsx --tsconfig scripts/tsconfig.json scripts/run-questions.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@ai-sdk/react": "^1.2.12",
    "ai": "^4.3.19",
    "drizzle-orm": "^0.38.4",
    "next": "^15.1.0",
    "openai": "^4.77.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
